# Copy to .env and fill in. NEVER commit .env.
# --- Environment selection ---
TRADING_ENV=testnet                 # testnet | mainnet (typos are rejected at startup)
BINANCE_TESTNET_KEY=                 # from https://testnet.binancefuture.com
BINANCE_TESTNET_SECRET=
BINANCE_MAINNET_KEY=                 # leave EMPTY until live
BINANCE_MAINNET_SECRET=
MAINNET_CONFIRMED=                   # must be exactly "yes" to allow LIVE trading; else mainnet stays in safe mode

# --- Trading costs (% of notional, per side) — used in NET PnL + ML labels ---
TAKER_FEE_PCT=0.04                   # Binance USDⓈ-M taker (market fill)
MAKER_FEE_PCT=0.02                   # maker (resting limit fill; grid)
SLIPPAGE_PCT=0.02                    # estimated adverse slippage on market legs

# --- Global risk caps (enforced by risk engine; bots cannot exceed) ---
MAX_LEVERAGE=5
RISK_PCT_PER_TRADE=1.0
MAX_DAILY_LOSS_PCT=4.0
MAX_ACCOUNT_DRAWDOWN_PCT=20.0
MAX_CONCURRENT_POSITIONS=5
MAX_NOTIONAL_PER_SYMBOL_PCT=30.0
DEFAULT_MARGIN_TYPE=ISOLATED
MIN_SIGNAL_CONFIDENCE=0.55

# --- Optional signal engines (all free / off by default) ---
TV_WEBHOOK_SECRET=                   # TradingView alerts (optional)
OLLAMA_BASE_URL=http://localhost:11434   # local free LLM (optional)
OLLAMA_MODEL=llama3.1

# --- Ops ---
DB_PATH=./data/trader.db
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000
